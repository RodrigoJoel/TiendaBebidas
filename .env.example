# Access Token de Mercado Pago (Developers > Tus integraciones > Credenciales).
# Usar el de PRUEBA mientras se testea, el de PRODUCCIÓN cuando esté todo validado.
MP_ACCESS_TOKEN=

# Clave secreta de Webhooks de Mercado Pago (Tus integraciones > Webhooks).
# Opcional: si se carga, /api/webhook-mercadopago rechaza avisos sin firma
# válida. Sin ella igual es seguro, porque cada pago se consulta a Mercado Pago.
MP_WEBHOOK_SECRET=

# JSON completo de la cuenta de servicio de Firebase, en una sola línea,
# o el mismo JSON codificado en base64 (recomendado para pegar en Vercel).
# Se genera en Firebase Console > Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Casilla desde la que salen los mails de pedidos (SMTP). Con Gmail:
# SMTP_USER es la dirección de Gmail y SMTP_PASS una "contraseña de aplicación"
# (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de
# aplicaciones), NO la contraseña normal de la cuenta.
SMTP_USER=
SMTP_PASS=

# Opcionales: solo si se usa otro proveedor en lugar de Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# A qué casilla llega el aviso de cada pedido nuevo. Opcional: si no se carga,
# llega al mail del administrador de la tienda.
AVISO_PEDIDOS_EMAIL=
